{
	"$schema": "https://biomejs.dev/schemas/2.6.3/schema.json",
	"files": {
		"includes": [
			"**",
			"!**/dist",
			"!**/coverage",
			"!**/node_modules",
			"!**/.git",
			"!**/.tmp",
			"!**/.claude",
			"!**/test-results",
			"!**/test-results.json",
			"!**/.vitest"
		]
	},
	"markdown": {
		"formatter": { "enabled": false },
		"linter": { "enabled": false }
	},
	"yaml": {
		"formatter": { "enabled": false },
		"linter": { "enabled": false }
	},
	"linter": {
		"rules": {
			"complexity": {
				"useLiteralKeys": "off"
			}
		}
	},
	"overrides": [
		{
			"includes": ["**/*.test.ts", "**/__tests__/**/*.ts"],
			"linter": {
				"rules": {
					"suspicious": {
						"noExplicitAny": "off"
					},
					"style": {
						"noNonNullAssertion": "off"
					},
					"complexity": {
						"noForEach": "off",
						"noStaticOnlyClass": "off"
					}
				}
			}
		}
	]
}
