{
	"$schema": "https://biomejs.dev/schemas/1.9.4/schema.json",
	"files": {
		"ignore": [
			"dist/**",
			"coverage/**",
			"node_modules/**",
			".git/**",
			"test-results/**",
			"test-results.json"
		]
	},
	"linter": {
		"rules": {
			"complexity": {
				"useLiteralKeys": "off"
			}
		}
	},
	"overrides": [
		{
			"include": ["**/*.test.ts", "**/__tests__/**/*.ts"],
			"linter": {
				"rules": {
					"suspicious": {
						"noExplicitAny": "off"
					},
					"style": {
						"noNonNullAssertion": "off"
					},
					"complexity": {
						"noForEach": "off",
						"noStaticOnlyClass": "off"
					}
				}
			}
		}
	]
}
