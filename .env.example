# YNAB MCP Server configuration. Copy this file to .env and fill in your values.

# Required: your YNAB Personal Access Token.
# Create one at https://app.ynab.com/settings/developer
YNAB_ACCESS_TOKEN=your_ynab_personal_access_token_here

# Optional: budget used when a tool call omits budget_id (the UUID from the
# budget's YNAB URL). Leave empty to choose a budget at runtime.
# YNAB_DEFAULT_BUDGET_ID=

# Optional: write policy. preview (default) requires a confirmation token from
# a preview call before each write; enabled runs writes directly; read-only
# does not register write tools.
# YNAB_MCP_WRITE_MODE=preview

# Optional: which tools are exposed. full (default) or core.
# YNAB_MCP_TOOL_PROFILE=full

# Optional: directory for exported transaction files.
# Default: ~/Downloads on Windows/macOS, ~/Documents (or $XDG_DOCUMENTS_DIR) on Linux.
# YNAB_EXPORT_PATH=

# Optional: trace, debug, info (default), warn, error or fatal.
# debug and trace also log each YNAB request's rate-limit check to stderr.
# LOG_LEVEL=info

# Testing
# Live tests are off unless this is 'true' and YNAB_ACCESS_TOKEN is a real token.
# Offline test projects ignore it and never contact the YNAB API.
# RUN_LIVE_YNAB_TESTS=true
# TEST_BUDGET_ID=
# TEST_ACCOUNT_ID=
# VERBOSE_TESTS=true
