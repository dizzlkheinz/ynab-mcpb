# YNAB MCP Server Environment Configuration
# Copy this file to .env and fill in your actual values

# Required: Your YNAB Personal Access Token
# Get this from: https://app.youneedabudget.com/settings/developer
YNAB_ACCESS_TOKEN=your_ynab_personal_access_token_here

# Optional: Node.js environment (development, production, test)
NODE_ENV=development

# Optional: Logging level (error, warn, info, debug)
LOG_LEVEL=info

# Export settings
# Directory where exported transaction files are saved
# Default: Windows/Mac = ~/Downloads, Linux/Unix = ~/Documents (or $XDG_DOCUMENTS_DIR)
# Examples: C:\Users\YourName\Desktop, /home/user/exports, ./data, ~/Desktop
YNAB_EXPORT_PATH=

# Cache configuration
# Maximum number of entries in the in-memory cache (default: 1000)
# Set to 0 to disable caching entirely
YNAB_MCP_CACHE_MAX_ENTRIES=1000

# Default time-to-live for cache entries in milliseconds (default: 300000 = 5 minutes)
YNAB_MCP_CACHE_DEFAULT_TTL_MS=300000

# Default stale-while-revalidate window in milliseconds (default: 120000 = 2 minutes)
# Used when stale-while-revalidate is explicitly requested but not specified
YNAB_MCP_CACHE_STALE_MS=120000

# Delta Request Feature Flag (Optional)
# Enable delta requests to reduce API response sizes and improve performance
# When enabled, the server tracks server_knowledge values and requests only
# changes since the last fetch (deltas) instead of full datasets
# Default: false (must be exactly 'true' or 'false'; any other value fails startup)
# Set to 'true' to enable delta requests
YNAB_MCP_ENABLE_DELTA=false

# Optional: Testing & Test Execution Settings
# Live tests are disabled by default even when YNAB_ACCESS_TOKEN is present.
# Set to 'true' to explicitly allow tests to contact the real YNAB API.
# RUN_LIVE_YNAB_TESTS=true
# Set to 'true' to force live/end-to-end tests off (overrides RUN_LIVE_YNAB_TESTS).
# SKIP_E2E_TESTS=true
# Set to 'true' to enable verbose logs/output during test suites
# VERBOSE_TESTS=true

# Optional: Throttled Integration Test Rate-Limiting Settings
# Configure rate limits specifically for running the throttled integration test suite
# RATE_LIMIT_PER_HOUR=200
# RATE_LIMIT_BUFFER=10
# RATE_LIMIT_WINDOW_MS=3600000
# RATE_LIMIT_MAX_WAIT_MS=5000

# Optional: Server rate limiter logging
# Set to 'true' to log each rate limit check to stderr (also on when LOG_LEVEL=debug)
# RATE_LIMIT_LOGGING=true

# Optional: Tool exposure and write safety
# Tool profile controlling which tools are exposed
# Values: full (default), core, read-only
# YNAB_MCP_TOOL_PROFILE=full
# Write mode controlling whether write tools are allowed
# Values: preview (default; each write needs a confirmation token from a preview call),
#         enabled (writes run directly), read-only (write tools are not registered)
# YNAB_MCP_WRITE_MODE=preview

# Optional: Live test budget and account
# TEST_BUDGET_ID=
# TEST_ACCOUNT_ID=

# Optional: Script and CI settings
# DOTENV_CONFIG_PATH=
# CI=true
