{
	"name": "@dizzlkheinz/ynab-mcpb",
	"version": "0.29.1",
	"mcpName": "io.github.dizzlkheinz/ynab-mcpb",
	"description": "Local-first YNAB MCP workflows for reconciliation, receipt splitting, safe bulk cleanup, scheduled transactions, and spending analysis",
	"main": "dist/index.js",
	"type": "module",
	"bin": {
		"ynab-mcp-server": "bin/ynab-mcp-server.cjs"
	},
	"scripts": {
		"build": "npm run clean && npm run lint && tsc --project tsconfig.prod.json && node esbuild.config.mjs && npm run verify-build && npm run verify:metadata",
		"clean": "rimraf dist",
		"dev": "tsc --watch",
		"start": "node dist/index.js",
		"verify-build": "node scripts/verify-build.js",
		"verify:metadata": "tsx scripts/verify-metadata.ts",
		"measure:tools": "tsx scripts/measure-tool-profiles.ts",
		"lint": "biome lint .",
		"lint:fix": "biome check --write .",
		"format": "biome format --write .",
		"format:check": "biome format .",
		"type-check": "tsc --noEmit && tsc -p tsconfig.test.json",
		"test": "vitest run --project unit",
		"test:integration": "vitest run --project integration",
		"test:live": "node scripts/run-live-integration-smoke.js",
		"test:coverage": "vitest run --coverage --project unit",
		"test:watch": "vitest --project unit --project integration",
		"test:all": "vitest run --project unit --project integration",
		"package:mcpb": "node scripts/package-mcpb.js",
		"pr:description": "node scripts/create-pr-description.js",
		"pr:create": "npm run pr:description && gh pr create --body-file .pr-description.md",
		"prepare": "npm run build",
		"prepublishOnly": "npm test && npm run verify:metadata"
	},
	"keywords": [
		"mcp",
		"ynab",
		"budget",
		"finance",
		"reconciliation",
		"receipts",
		"spending-analysis"
	],
	"author": "dizzlkheinz",
	"license": "AGPL-3.0",
	"engines": {
		"node": ">=24.0.0"
	},
	"dependencies": {
		"@modelcontextprotocol/sdk": "^1.32.1",
		"chrono-node": "^2.10.3",
		"date-fns": "^4.4.0",
		"dotenv": "^18.0.8",
		"fuzzball": "^2.2.6",
		"papaparse": "^5.7.0",
		"ynab": "^4.5.0",
		"zod": "^4.6.7",
		"zod-validation-error": "^5.0.0"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.15",
		"@types/node": "^26.6.5",
		"@types/papaparse": "^5.5.2",
		"@vitest/coverage-v8": "^5.0.5",
		"esbuild": "^0.28.2",
		"rimraf": "^6.1.3",
		"tsx": "^4.23.15",
		"typescript": "^7.0.2",
		"vitest": "^5.0.5"
	},
	"directories": {
		"doc": "docs"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/dizzlkheinz/ynab-mcpb.git"
	},
	"types": "./dist/index.d.ts",
	"bugs": {
		"url": "https://github.com/dizzlkheinz/ynab-mcpb/issues"
	},
	"homepage": "https://github.com/dizzlkheinz/ynab-mcpb#readme",
	"files": [
		"bin/",
		"dist/**/*.js",
		"dist/**/*.cjs",
		"dist/**/*.d.ts",
		"!dist/**/__tests__/**",
		"server.json",
		"LICENSE.MD"
	]
}
